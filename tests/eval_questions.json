      "question": "How does AI reply suggestion work?",
      "must_include": [["Generate Smart Replies", "Generate Reply"], ["sparkles", "AI Assistant"]],
      "language": "english"
    },
    {
      "id": "ai_matched_suggestions",
      "question": "Are suggestions AI-matched by skills?",
      "must_include": ["Get Connections", ["yes", "are AI-matched", "AI‑matched"]],
      "must_not_include": ["No, suggestions are not", "aren't AI-matched by skills"],
      "language": "english"
    },
    {
      "id": "find_react_developers",
      "question": "Find me React developers",
      "must_include": [["Search", "Find People", "Explore"]],
      "language": "english"
    },
