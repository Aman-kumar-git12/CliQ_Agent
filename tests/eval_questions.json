{
  "_notes": [
    "Each case has `question` or `turns` (multi-turn; checks apply to the LAST answer).",
    "must_include: every item must appear (case-insensitive). An item that is a list passes if ANY of its strings appears.",
    "must_not_include: none of these may appear. The global checks in run_eval.py also fail any answer with a link outside the allowlist.",
    "language: english | hinglish | hindi. Optional: current_path, user_context (what the backend would send)."
  ],
  "defaults": {
    "must_not_include": [
      "I don't have information about that yet",
      "I can only answer questions about CliQ based on the available platform information"
    ],
    "user_context": {"firstname": "Asha", "pendingRequests": 3, "unreadNotifications": 2, "expertiseFilled": false},
    "current_path": "/home"
  },
  "cases": [
    {
      "id": "send_request",
      "question": "How do I send a connection request?",
      "must_include": ["Connect", ["Requested", "Interested"]],
      "language": "english"
    },
    {
      "id": "create_post",
      "question": "How do I create a post?",
      "must_include": ["Share Post", ["New Post", "Create"]],
      "must_not_include": ["50 characters"],
      "language": "english"
    },
    {
      "id": "followup_video",
      "turns": ["How do I create a post?", "can I add a video to it?"],
      "must_include": [["yes", "you can"], "50 MB"],
      "must_not_include": ["does not support video", "doesn't support video", "no video", "50 characters"],
      "language": "english"
    },
    {
      "id": "followup_delete",
      "turns": ["How do I create a post?", "can I add a video to it?", "how do I delete it later?"],
      "must_include": ["Delete Post", ["trash", "Delete Post?"]],
      "language": "english"
    },
    {
      "id": "multi_part",
      "question": "Create a post and where are my requests?",
      "must_include": ["Share Post", "Requests", "###"],
      "language": "english"
    },
    {
