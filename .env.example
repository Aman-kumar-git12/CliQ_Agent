# Copy to .env and fill in. Only DATABASE_URL and GROQ_API_KEY are required.

# MongoDB Atlas connection string (database name defaults to website_db)
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/website_db?retryWrites=true&w=majority"
# DATABASE_NAME=website_db

# Groq API key and models
GROQ_API_KEY=
MESSAGE_ASSISTANT_CLASSIFIER_MODEL=openai/gpt-oss-20b
MESSAGE_ASSISTANT_RESPONSE_MODEL=openai/gpt-oss-120b
# MESSAGE_ASSISTANT_FALLBACK_MODEL=   (defaults to the classifier model)
# Optional limits on every Groq call (defaults shown). LLM_MAX_RETRIES above 0 lets the SDK wait out 429s.
# LLM_TIMEOUT_SECONDS=20
# LLM_CLASSIFIER_TIMEOUT_SECONDS=8
# LLM_MAX_RETRIES=0
# LLM_REASONING_EFFORT=low   (gpt-oss models only; empty = the model's default, "medium")

# The frontend origin allowed by CORS ("*" allows any)
FRONTEND_URL="http://localhost:5173"

# Required shared secret: every endpoint except /api/health refuses calls without it; must match the backend's AGENT_INTERNAL_KEY
AGENT_INTERNAL_KEY=
# Optional: the old key, still accepted while rotating AGENT_INTERNAL_KEY (remove once the backend uses the new one)
AGENT_INTERNAL_KEY_PREVIOUS=

# Optional Sentry error monitoring: leave empty to disable
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional
# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=INFO
# LOG_FORMAT=text   ("json" for one JSON object per line)
# FEEDBACK_SIMILARITY_THRESHOLD=0.92
# FEEDBACK_MIN_APPROVALS=2
# SEMANTIC_SEARCH_MIN_SCORE=0.55
# SEMANTIC_SEARCH_FALLBACK_MIN_SCORE=0.2
# SMART_* ranking weights: see src/core/config.py

# Optional: this service's public URL to keep it awake on Render (off by default; uses ~744 free hours/month)
KEEPALIVE_URL=
