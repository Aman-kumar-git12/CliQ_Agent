# Copy to .env and fill in. Only DATABASE_URL and GROQ_API_KEY are required.

# MongoDB Atlas connection string (database name defaults to website_db)
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/website_db?retryWrites=true&w=majority"
# DATABASE_NAME=website_db

# Groq API key and models
GROQ_API_KEY=
MESSAGE_ASSISTANT_CLASSIFIER_MODEL=openai/gpt-oss-20b
MESSAGE_ASSISTANT_RESPONSE_MODEL=openai/gpt-oss-120b
# MESSAGE_ASSISTANT_FALLBACK_MODEL=   (defaults to the classifier model)

# The frontend origin allowed by CORS ("*" allows any)
FRONTEND_URL="http://localhost:5173"

# Shared secret the backend sends for feedback learning; must match the backend's AGENT_INTERNAL_KEY
AGENT_INTERNAL_KEY=

# Optional
# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=INFO
# FEEDBACK_SIMILARITY_THRESHOLD=0.92
# FEEDBACK_MIN_APPROVALS=2
# SEMANTIC_SEARCH_MIN_SCORE=0.55
# SEMANTIC_SEARCH_FALLBACK_MIN_SCORE=0.2
# SMART_* ranking weights: see src/core/config.py
